---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-400 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="space-y-4">
      <div class="flex items-center gap-2 text-xl font-bold text-white">
        <span class="p-1 bg-gradient-to-tr from-indigo-500 to-emerald-400 rounded-md text-slate-950 text-sm font-black">⚡</span>
        Apex<span class="text-indigo-400">SEO</span>
      </div>
      <p class="text-sm text-slate-400 leading-relaxed">
        Data-driven SEO as a Service. We grow organic search traffic, keyword rankings, and revenue for fast-growing businesses.
      </p>
    </div>

    <div>
      <h4 class="text-white font-semibold text-sm mb-4">Services</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/services#technical" class="hover:text-indigo-400 transition">Technical SEO Audit</a></li>
        <li><a href="/services#onpage" class="hover:text-indigo-400 transition">On-Page Optimization</a></li>
        <li><a href="/services#linkbuilding" class="hover:text-indigo-400 transition">High-Authority Link Building</a></li>
        <li><a href="/services#local" class="hover:text-indigo-400 transition">Local SEO & GBP</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white font-semibold text-sm mb-4">Company</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/case-studies" class="hover:text-indigo-400 transition">Case Studies</a></li>
        <li><a href="/pricing" class="hover:text-indigo-400 transition">Pricing Plans</a></li>
        <li><a href="/blog" class="hover:text-indigo-400 transition">SEO Blog</a></li>
        <li><a href="/contact" class="hover:text-indigo-400 transition">Get in Touch</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white font-semibold text-sm mb-4">Free Resource</h4>
      <p class="text-sm text-slate-400 mb-4">
        Get a comprehensive 30-point technical SEO audit delivered straight to your inbox.
      </p>
      <a href="/#free-audit" class="inline-block text-xs font-semibold text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 px-3 py-2 rounded-lg hover:bg-indigo-500/20 transition">
        Claim Free Audit →
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-6 border-t border-slate-900 text-xs text-center text-slate-500">
    &copy; {currentYear} ApexSEO. All rights reserved. Built with Astro & Cloudflare/Vercel.
  </div>
</footer>
