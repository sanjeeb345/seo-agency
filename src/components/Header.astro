---
const navLinks = [
  { name: 'Services', href: '/services' },
  { name: 'Case Studies', href: '/case-studies' },
  { name: 'Pricing', href: '/pricing' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-white tracking-tight">
      <span class="p-1.5 bg-gradient-to-tr from-indigo-500 to-emerald-400 rounded-lg text-slate-950 font-black">
        ⚡
      </span>
      <span>Apex<span class="text-indigo-400">SEO</span></span>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="hover:text-indigo-400 transition-colors"
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- CTA Button -->
    <div class="flex items-center gap-4">
      <a 
        href="/#free-audit" 
        class="bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-600 hover:to-indigo-700 text-white font-semibold text-sm px-4 py-2 rounded-xl shadow-lg shadow-indigo-500/20 transition-all hover:scale-105"
      >
        Free SEO Audit
      </a>
    </div>
  </div>
</header>
