---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<MainLayout 
  title="SEO Blog & Insights"
  description="Actionable guides and technical SEO insights from the ApexSEO team."
>
  <div class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">SEO Insights & Guides</h1>
      <p class="text-slate-400 text-lg">
        Learn how we optimize Core Web Vitals, build domain authority, and scale search engine visibility.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <article class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 space-y-4 flex flex-col justify-between hover:border-indigo-500/50 transition">
          <div class="space-y-3">
            <div class="flex items-center gap-2 text-xs text-indigo-400">
              {post.data.tags.map((tag) => (
                <span class="bg-indigo-500/10 border border-indigo-500/20 px-2.5 py-0.5 rounded-full">
                  #{tag}
                </span>
              ))}
            </div>
            <h2 class="text-xl font-bold text-white leading-snug">
              <a href={`/blog/${post.id}`} class="hover:text-indigo-400 transition">
                {post.data.title}
              </a>
            </h2>
            <p class="text-xs text-slate-400 line-clamp-3">
              {post.data.description}
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-500">
            <span>By {post.data.author}</span>
            <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
          </div>
        </article>
      ))}
    </div>
  </div>
</MainLayout>
