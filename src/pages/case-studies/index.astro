---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const caseStudies = await getCollection('case-studies');
---

<MainLayout 
  title="Proven SEO Case Studies & Client Results | askaseo"
  description="Explore real case studies showing how askaseo scaled search traffic and organic ARR for high-growth tech companies."
>
  <div class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 bg-emerald-500/10 px-3.5 py-1.5 rounded-full border border-emerald-500/20">
        Proven Impact
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">Verified Client Growth</h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Real case studies demonstrating how our technical architecture and topical authority outrank competitors.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {caseStudies.map((cs) => (
        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-8 space-y-6 hover:border-indigo-500/50 transition flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>{cs.data.industry}</span>
              <span class="font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">{cs.data.metric}</span>
            </div>
            <h2 class="text-2xl font-bold text-white">
              <a href={`/case-studies/${cs.id}`} class="hover:text-indigo-400 transition">
                {cs.data.client}
              </a>
            </h2>
            <p class="text-xs text-slate-400 leading-relaxed">
              {cs.data.description}
            </p>
          </div>
          <a href={`/case-studies/${cs.id}`} class="inline-block text-xs font-semibold text-indigo-400 hover:text-indigo-300">
            Read Case Study →
          </a>
        </div>
      ))}
    </div>
  </div>
</MainLayout>
