---
import MainLayout from '../layouts/MainLayout.astro';
import AuditForm from '../components/AuditForm.astro';
---

<MainLayout 
  title="Contact Us | ApexSEO Agency"
  description="Ready to grow your organic traffic? Get in touch with our SEO team today."
>
  <div class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-4 mb-12">
      <h1 class="text-4xl font-extrabold text-white">Let's Talk SEO Strategy</h1>
      <p class="text-slate-400">
        Have questions about our services or pricing? Request a free audit or send us a message below.
      </p>
    </div>

    <AuditForm />
  </div>
</MainLayout>
