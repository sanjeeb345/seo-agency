---
import MainLayout from '../layouts/MainLayout.astro';
import AuditForm from '../components/AuditForm.astro';
---

<MainLayout 
  title="Contact Sanjeeb Chetri | askaseo"
  description="Connect directly with Senior SEO Specialist Sanjeeb Kumar Chetri. Claim a free 30-point audit or discuss custom enterprise SEO engineering."
>
  <div class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-400 bg-cyan-500/10 px-3.5 py-1.5 rounded-full border border-cyan-500/20">
        Direct Principal Communication
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">
        Let's Talk Search Strategy
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        No account manager gatekeepers. Reach out directly to <strong class="text-white font-semibold">Sanjeeb Kumar Chetri</strong> to discuss your website's search performance, migrations, or organic revenue goals.
      </p>
    </div>

    <!-- Direct Contact Methods Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-20 max-w-5xl mx-auto">
      
      <!-- Email -->
      <a 
        href="mailto:sanjeebchetri9999@gmail.com" 
        class="rounded-2xl p-6 bg-white/[0.03] border border-white/[0.08] hover:border-indigo-500/50 hover:bg-white/[0.06] transition-all group space-y-3"
      >
        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Direct Email</div>
          <div class="text-sm font-semibold text-white mt-1 group-hover:text-cyan-300 transition-colors truncate">
            sanjeebchetri9999@gmail.com
          </div>
        </div>
      </a>

      <!-- Phone -->
      <a 
        href="tel:+917399482520" 
        class="rounded-2xl p-6 bg-white/[0.03] border border-white/[0.08] hover:border-cyan-500/50 hover:bg-white/[0.06] transition-all group space-y-3"
      >
        <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Phone & WhatsApp</div>
          <div class="text-sm font-semibold text-white mt-1 group-hover:text-cyan-300 transition-colors">
            +91 73994 82520
          </div>
        </div>
      </a>

      <!-- LinkedIn -->
      <a 
        href="https://linkedin.com/in/sanjeebchetri" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="rounded-2xl p-6 bg-white/[0.03] border border-white/[0.08] hover:border-indigo-500/50 hover:bg-white/[0.06] transition-all group space-y-3"
      >
        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">LinkedIn Profile</div>
          <div class="text-sm font-semibold text-white mt-1 group-hover:text-cyan-300 transition-colors truncate">
            in/sanjeebchetri
          </div>
        </div>
      </a>

      <!-- Location -->
      <div class="rounded-2xl p-6 bg-white/[0.03] border border-white/[0.08] space-y-3">
        <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Headquarters</div>
          <div class="text-sm font-semibold text-white mt-1">
            Guwahati, Assam, India
          </div>
        </div>
      </div>

    </div>

    <!-- Free Audit Intake Section -->
    <div class="max-w-5xl mx-auto">
      <AuditForm />
    </div>

  </div>
</MainLayout>
