---
import MainLayout from '../layouts/MainLayout.astro';
import AuditForm from '../components/AuditForm.astro';
---

<MainLayout 
  title="Contact Us | askaseo"
  description="Ready to scale your organic search pipeline? Get in touch with the askaseo team today."
>
  <div class="py-20 md:py-28 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-4 mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 bg-indigo-500/10 px-3.5 py-1.5 rounded-full border border-indigo-500/20">
        Direct Strategy
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">Let's Talk Search Strategy</h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Ready to outrank competitors and scale organic ARR? Claim your free 30-point audit below or email us directly at <a href="mailto:hello@askaseo.com" class="text-cyan-400 hover:underline font-semibold">hello@askaseo.com</a>.
      </p>
    </div>

    <AuditForm />
  </div>
</MainLayout>
