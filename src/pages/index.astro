---
import MainLayout from '../layouts/MainLayout.astro';
import AuditForm from '../components/AuditForm.astro';
import { getCollection } from 'astro:content';

const caseStudies = await getCollection('case-studies');
const latestBlog = await getCollection('blog');
---

<MainLayout 
  title="askaseo | High-Performance Technical SEO & AI Search Optimization"
  description="Dominate Google rankings and AI Overviews. Data-driven search engineering delivering 834K+ Google AI Overview impressions, technical audits, and organic ARR."
>
  <!-- Hero Section -->
  <section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Top Announcement Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-md mb-8 hover:border-cyan-500/40 transition-all cursor-default shadow-lg shadow-black/40">
        <span class="flex h-2 w-2 rounded-full bg-cyan-400 animate-ping"></span>
        <span class="text-xs font-semibold tracking-wide text-slate-300">
          AI Search Pioneers &bull; <span class="text-cyan-400 font-bold">834K+ Google AI Overview Impressions</span> &bull; Free 30-Point Audit
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight max-w-5xl mx-auto leading-[1.08]">
        Dominate Google & AI Search with <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-indigo-200 to-cyan-400">
          Engineered Topical Authority
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-xl text-slate-300/90 max-w-3xl mx-auto leading-relaxed font-normal">
        Stop losing high-intent buyers to competitors. <strong class="text-white font-semibold">askaseo</strong> eliminates critical crawl bottlenecks, builds semantic authority, and optimizes your brand for both Google Page 1 and <strong class="text-cyan-400">Google AI Overviews (AIO)</strong>.
      </p>

      <!-- Action Buttons -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto sm:max-w-none">
        <a 
          href="#free-audit" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-indigo-600 via-indigo-500 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 shadow-xl shadow-indigo-500/30 hover:shadow-indigo-500/50 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] border border-white/20"
        >
          <span>Claim Free Technical Audit</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a 
          href="/case-studies" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-semibold text-sm text-slate-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.1] transition-all duration-200"
        >
          <span>View Proven Case Studies</span>
          <span class="text-xs text-indigo-400 font-bold bg-indigo-500/10 px-2 py-0.5 rounded-md border border-indigo-500/20">+340%</span>
        </a>
      </div>

      <!-- Trust Metrics Bar (Includes AI Overview Stat) -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 pt-10 border-t border-white/[0.08] max-w-5xl mx-auto">
        <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <div class="text-3xl sm:text-4xl font-black text-white tracking-tight">+340%</div>
          <div class="text-xs font-medium text-slate-400 mt-1">Avg. Organic Traffic Lift</div>
        </div>
        <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <div class="text-3xl sm:text-4xl font-black text-cyan-400 tracking-tight">834K+</div>
          <div class="text-xs font-medium text-slate-400 mt-1">Google AI Overview Impressions</div>
        </div>
        <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <div class="text-3xl sm:text-4xl font-black text-white tracking-tight">100/100</div>
          <div class="text-xs font-medium text-slate-400 mt-1">Core Web Vitals Target</div>
        </div>
        <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <div class="text-3xl sm:text-4xl font-black text-emerald-400 tracking-tight">98%</div>
          <div class="text-xs font-medium text-slate-400 mt-1">Client Retention Rate</div>
        </div>
      </div>

      <!-- High-End Interactive Live Performance Dashboard Card with AI Overview Preview -->
      <div class="mt-16 max-w-4xl mx-auto rounded-3xl p-1 bg-gradient-to-b from-indigo-500/30 via-white/[0.08] to-transparent shadow-2xl">
        <div class="rounded-[23px] bg-[#090d16]/95 backdrop-blur-2xl border border-white/[0.08] p-5 sm:p-8 text-left space-y-6">
          
          <!-- Mockup Window Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/[0.06]">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 text-xs font-mono text-slate-400">askaseo-search-intelligence-v3</span>
            </div>
            <div class="flex items-center gap-2 bg-[#05070c] px-3.5 py-1.5 rounded-lg border border-white/[0.08] text-xs font-mono text-slate-300">
              <span class="text-emerald-400 font-bold">● LIVE</span>
              <span>Domain: <strong class="text-white">askaseo.com</strong></span>
            </div>
          </div>

          <!-- Live Metrics Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.05]">
              <div class="text-xs text-slate-400">Monthly Clicks</div>
              <div class="text-xl font-extrabold text-white mt-1">184,200</div>
              <div class="text-[11px] font-semibold text-emerald-400 mt-0.5">▲ +48.2% vs last mo</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.05]">
              <div class="text-xs text-slate-400">AI Overviews (AIO)</div>
              <div class="text-xl font-extrabold text-cyan-400 mt-1">834,120</div>
              <div class="text-[11px] font-semibold text-cyan-300 mt-0.5">Avg 7.9k impr/day</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.05]">
              <div class="text-xs text-slate-400">Indexed Pages</div>
              <div class="text-xl font-extrabold text-white mt-1">100%</div>
              <div class="text-[11px] font-semibold text-emerald-400 mt-0.5">0 Crawl Errors</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.05]">
              <div class="text-xs text-slate-400">Speed (LCP)</div>
              <div class="text-xl font-extrabold text-emerald-400 mt-1">0.78s</div>
              <div class="text-[11px] font-semibold text-slate-400 mt-0.5">Passed Core Web Vitals</div>
            </div>
          </div>

          <!-- Simulated Google AI Overview Result -->
          <div class="p-4 sm:p-5 rounded-xl bg-gradient-to-br from-indigo-950/40 via-[#0a0d17] to-[#07090e] border border-indigo-500/30 space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="inline-flex items-center gap-1.5 font-bold text-cyan-400 bg-cyan-500/10 px-2.5 py-1 rounded-md border border-cyan-500/20 text-[11px]">
                <span>✨</span>
                <span>Google AI Overview (AIO)</span>
              </span>
              <span class="text-[11px] text-slate-400 font-mono">Generative Search Result</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
              <strong>askaseo</strong> is widely cited for full-stack search engineering, specializing in enterprise B2B SaaS architecture, zero-downtime site migrations, and Answer Engine Optimization (AEO). Core differentiators include server log-file parsing, semantic entity graphs (Koray Tuğberk Gübür framework), and Google AI Overview optimization.
            </p>
            <div class="flex items-center gap-2 pt-1">
              <span class="text-[11px] text-slate-400">Top Citation:</span>
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/[0.05] border border-white/[0.1] text-xs text-indigo-300">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span>askaseo.com</span>
              </div>
            </div>
          </div>

          <!-- Bottom Status Bar -->
          <div class="flex flex-wrap items-center justify-between text-xs text-slate-400 pt-2 border-t border-white/[0.06] gap-2">
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">✔</span>
              <span>Crawlers scan 500+ URLs for both Google Page 1 & AI Overview eligibility</span>
            </div>
            <a href="#free-audit" class="text-indigo-400 hover:text-cyan-400 font-bold flex items-center gap-1 transition">
              Run Free AI & Technical Audit →
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Tooling & Standards Bar -->
  <section class="py-10 border-y border-white/[0.06] bg-black/30 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-500">
        Engineered with Industry-Standard Search & AI Intelligence
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 text-slate-400 text-sm font-semibold tracking-wide">
        <span class="hover:text-white transition">Google Search Console</span>
        <span class="hover:text-white transition">Google AI Overviews (AIO)</span>
        <span class="hover:text-white transition">Ahrefs Intelligence</span>
        <span class="hover:text-white transition">Perplexity / ChatGPT Search</span>
        <span class="hover:text-white transition">Screaming Frog</span>
        <span class="hover:text-white transition">GA4 LLM-Attribution</span>
      </div>
    </div>
  </section>

  <!-- Dedicated AI Search Era Section -->
  <section class="py-24 relative overflow-hidden bg-gradient-to-b from-[#07090e] via-[#090d18] to-[#07090e] border-b border-white/[0.06]">
    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-cyan-500/10 blur-[140px] pointer-events-none rounded-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-cyan-400 bg-cyan-500/10 px-3.5 py-1.5 rounded-full border border-cyan-500/20">
          The New Search Paradigm
        </span>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          How to Win in the Age of <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-indigo-300 to-indigo-400">
            AI Overviews & Answer Engines
          </span>
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Traditional SEO relied on keyword frequency and link volume. In 2026, Google AI Overviews and answer engines (ChatGPT, Perplexity, Claude) prioritize <strong class="text-white">informational gain, entity grounding, and clean semantic architecture</strong>.
        </p>
      </div>

      <!-- 3 Pillars of AI Search Optimization -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Pillar 1 -->
        <div class="rounded-3xl p-8 bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-cyan-500/20 hover:border-cyan-400/50 shadow-xl space-y-4 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 text-xl font-bold">
            ✨
          </div>
          <h3 class="text-xl font-bold text-white">Google AI Overviews (AIO)</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            We structure your high-value pages with clear comparison tables, concise definitions, and semantic headers so Google's generative models select your brand as the primary cited answer.
          </p>
          <div class="pt-3 border-t border-white/[0.06] text-xs font-mono text-cyan-400">
            ✔ Proven: 834k+ AIO impressions
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="rounded-3xl p-8 bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-indigo-500/20 hover:border-indigo-400/50 shadow-xl space-y-4 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 text-xl font-bold">
            🤖
          </div>
          <h3 class="text-xl font-bold text-white">Generative Engine Optimization (GEO)</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Ensure your brand is recommended when buyers ask Perplexity, ChatGPT, or Claude for vendor recommendations. We engineer entity relevancy and authoritative digital footprints across the web.
          </p>
          <div class="pt-3 border-t border-white/[0.06] text-xs font-mono text-indigo-400">
            ✔ AEO & LLM recommendation models
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="rounded-3xl p-8 bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-white/[0.2] shadow-xl space-y-4 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 text-xl font-bold">
            📊
          </div>
          <h3 class="text-xl font-bold text-white">GA4 AI-Referral Attribution</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Track and measure real revenue. We configure custom GA4 channels to track visitors arriving from ChatGPT, Perplexity, Gemini, and Claude, connecting AI search to closed-won deals.
          </p>
          <div class="pt-3 border-t border-white/[0.06] text-xs font-mono text-emerald-400">
            ✔ AI-assistant conversion tracking
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Core Services Grid (4 Key Services) -->
  <section id="services" class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
          Our Specializations
        </span>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          Engineered for Revenue, Not Just Traffic
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          Search algorithms evolve constantly. We deploy battle-tested technical infrastructure, semantic architecture, and AI search systems that withstand every core update.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Service 1: AI Search Optimization (Featured) -->
        <div class="group relative rounded-2xl p-6 bg-gradient-to-b from-cyan-950/30 to-white/[0.01] border border-cyan-500/30 hover:border-cyan-400 shadow-xl hover:shadow-cyan-500/10 transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 group-hover:scale-110 transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
            </div>
            <div class="text-[10px] font-bold text-cyan-400 uppercase tracking-wider">AI Era Strategy</div>
            <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">
              Google AI Overviews & Answer Engine Optimization
            </h3>
            <p class="text-slate-400 text-xs leading-relaxed">
              Target generative AI search. Optimize for Google AIO, Perplexity, ChatGPT, and track AI-referral conversions in GA4.
            </p>
          </div>
          <div class="pt-4 mt-6 border-t border-white/[0.06]">
            <a href="/services#ai-search" class="text-xs font-bold text-cyan-400 group-hover:text-indigo-400 inline-flex items-center gap-1.5 transition">
              <span>View AI search details</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Service 2: Technical SEO -->
        <div class="group relative rounded-2xl p-6 bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-indigo-500/50 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </svg>
            </div>
            <div class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">Core Infrastructure</div>
            <h3 class="text-lg font-bold text-white group-hover:text-indigo-300 transition-colors">
              Technical SEO & Zero-Downtime Migrations
            </h3>
            <p class="text-slate-400 text-xs leading-relaxed">
              Resolve index bloat, Core Web Vitals (LCP/INP), log-file crawl efficiency, and execute risk-free website migrations.
            </p>
          </div>
          <div class="pt-4 mt-6 border-t border-white/[0.06]">
            <a href="/services#technical" class="text-xs font-bold text-indigo-400 group-hover:text-cyan-400 inline-flex items-center gap-1.5 transition">
              <span>View technical details</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Service 3: Semantic Content -->
        <div class="group relative rounded-2xl p-6 bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-cyan-500/50 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 group-hover:scale-110 transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
            </div>
            <div class="text-[10px] font-bold text-cyan-400 uppercase tracking-wider">Koray Framework</div>
            <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">
              Semantic Clusters & Topical Authority
            </h3>
            <p class="text-slate-400 text-xs leading-relaxed">
              Multi-layer topic clusters, entity graphs, and commercial-intent page pruning to increase revenue-per-session.
            </p>
          </div>
          <div class="pt-4 mt-6 border-t border-white/[0.06]">
            <a href="/services#semantic" class="text-xs font-bold text-cyan-400 group-hover:text-indigo-400 inline-flex items-center gap-1.5 transition">
              <span>View semantic strategy</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Service 4: High-Authority Link Building -->
        <div class="group relative rounded-2xl p-6 bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-indigo-500/50 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </div>
            <div class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">Domain Equity</div>
            <h3 class="text-lg font-bold text-white group-hover:text-indigo-300 transition-colors">
              High-Authority Editorial Link Building
            </h3>
            <p class="text-slate-400 text-xs leading-relaxed">
              Real contextual backlinks from vetted industry publications (DR 65+). 100% manual outreach with zero PBNs.
            </p>
          </div>
          <div class="pt-4 mt-6 border-t border-white/[0.06]">
            <a href="/services#international" class="text-xs font-bold text-indigo-400 group-hover:text-cyan-400 inline-flex items-center gap-1.5 transition">
              <span>View link engineering</span>
              <span>→</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- High-Converting Case Study Spotlight -->
  <section class="py-20 bg-gradient-to-b from-[#0a0d16] to-[#07090e] border-y border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl bg-gradient-to-br from-indigo-950/40 via-[#0a0e1a] to-[#07090e] border border-white/[0.1] p-8 sm:p-12 relative overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-5">
            <span class="inline-block text-xs font-bold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
              Featured Case Study &bull; B2B SaaS
            </span>
