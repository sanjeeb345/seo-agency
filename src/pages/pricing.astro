---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="SEO Packages & Pricing | Transparent Monthly Retainers | askaseo"
  description="Transparent SEO agency pricing plans with no lock-in contracts. Measurable pipeline and organic traffic growth."
>
  <div class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20 space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-indigo-400 bg-indigo-500/10 px-3.5 py-1.5 rounded-full border border-indigo-500/20">
        Simple & Honest
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">
        Transparent Growth Retainers
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        No hidden setup fees. No 12-month lock-in contracts. Just predictable, data-driven organic pipeline growth.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      <!-- Starter -->
      <div class="rounded-3xl p-8 bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-white/[0.15] space-y-6 flex flex-col justify-between transition-all duration-300">
        <div class="space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">One-Time Setup</span>
          <h3 class="text-xl font-bold text-white">Full Technical Audit</h3>
          <p class="text-xs text-slate-300 leading-relaxed">Perfect for uncovering crawl errors, slow LCP bottlenecks, and indexing leaks.</p>
          <div class="text-4xl font-black text-white pt-2">$999 <span class="text-xs font-normal text-slate-400">flat rate</span></div>
          <ul class="text-xs text-slate-300 space-y-3 pt-6 border-t border-white/[0.06]">
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Full 40+ Point Technical Diagnostic</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Core Web Vitals Optimization Plan</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Indexation & Crawl Error Remediation</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> 1-on-1 Strategy Video Review</li>
          </ul>
        </div>
        <a href="/contact" class="w-full text-center bg-white/[0.06] hover:bg-white/[0.1] text-white font-bold py-3.5 rounded-xl border border-white/[0.1] transition text-xs">
          Order Technical Audit
        </a>
      </div>

      <!-- Growth (Featured) -->
      <div class="relative rounded-3xl p-8 bg-gradient-to-b from-indigo-950/70 via-[#0b0f1d] to-[#07090e] border-2 border-indigo-500/80 shadow-2xl shadow-indigo-500/20 space-y-6 flex flex-col justify-between transition-all duration-300 scale-100 md:-translate-y-2">
        <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 text-[11px] font-black text-slate-950 bg-gradient-to-r from-indigo-400 via-cyan-300 to-emerald-400 px-4 py-1 rounded-full uppercase tracking-wider shadow-lg">
          Most Popular
        </span>
        <div class="space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Monthly Growth Retainer</span>
          <h3 class="text-2xl font-black text-white">Growth Retainer</h3>
          <p class="text-xs text-slate-300 leading-relaxed">For fast-growing startups looking to outrank primary competitors and scale pipeline.</p>
          <div class="text-4xl font-black text-white pt-2">$1,999 <span class="text-xs font-normal text-slate-400">/month</span></div>
          <ul class="text-xs text-slate-200 space-y-3 pt-6 border-t border-white/[0.08]">
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Full Continuous Technical SEO Monitoring</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> 4 High-Intent SEO Articles & Landing Pages</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> 5 High-Authority Contextual Backlinks (DR 65+)</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Monthly Rank Tracking & Revenue Reporting</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Dedicated Slack Channel & Bi-weekly Sync</li>
          </ul>
        </div>
        <a href="/contact" class="w-full text-center bg-gradient-to-r from-indigo-600 via-indigo-500 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-extrabold py-3.5 rounded-xl transition text-xs shadow-lg shadow-indigo-600/30 border border-white/20">
          Start Growth Retainer
        </a>
      </div>

      <!-- Enterprise -->
      <div class="rounded-3xl p-8 bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-white/[0.15] space-y-6 flex flex-col justify-between transition-all duration-300">
        <div class="space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Scale-Ups & Enterprise</span>
          <h3 class="text-xl font-bold text-white">Enterprise Acceleration</h3>
          <p class="text-xs text-slate-300 leading-relaxed">Aggressive search acceleration for established multi-product or international brands.</p>
          <div class="text-4xl font-black text-white pt-2">$3,999+ <span class="text-xs font-normal text-slate-400">/month</span></div>
          <ul class="text-xs text-slate-300 space-y-3 pt-6 border-t border-white/[0.06]">
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Everything in Growth Plan</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> 10+ High-Intent Articles / Programmatic Pages</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> 12+ High-Authority Editorial Backlinks</li>
            <li class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Custom Data Pipeline & Executive Dashboard</li>
          </ul>
        </div>
        <a href="/contact" class="w-full text-center bg-white/[0.06] hover:bg-white/[0.1] text-white font-bold py-3.5 rounded-xl border border-white/[0.1] transition text-xs">
          Contact Enterprise Sales
        </a>
      </div>
    </div>
  </div>
</MainLayout>
