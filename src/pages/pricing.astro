---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="SEO Packages & Pricing | Transparent Monthly Retainers"
  description="Transparent SEO agency pricing plans for startups, SMBs, and enterprise businesses."
>
  <div class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Transparent SEO Pricing</h1>
      <p class="text-slate-400 text-lg">
        No hidden fees. No long-term lock-in contracts. Just predictable, data-driven organic growth.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Starter -->
      <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-8 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-white">One-Time Technical Audit</h3>
          <p class="text-xs text-slate-400">Perfect for identifying and resolving site speed & crawl errors.</p>
          <div class="text-4xl font-extrabold text-white">$999 <span class="text-xs font-normal text-slate-500">flat rate</span></div>
          <ul class="text-xs text-slate-300 space-y-3 pt-4 border-t border-slate-800">
            <li>✔ Full 40+ Point Technical Diagnostic</li>
            <li>✔ Core Web Vitals Optimization Plan</li>
            <li>✔ Indexation & Crawl Error Remediation</li>
            <li>✔ 1-on-1 Strategy Call (60 Mins)</li>
          </ul>
        </div>
        <a href="/contact" class="w-full text-center bg-slate-800 hover:bg-slate-700 text-white font-semibold py-3 rounded-xl transition text-sm">Order Audit</a>
      </div>

      <!-- Growth (Featured) -->
      <div class="bg-gradient-to-b from-indigo-950/80 to-slate-950 border-2 border-indigo-500 rounded-2xl p-8 space-y-6 flex flex-col justify-between relative shadow-xl shadow-indigo-500/10">
        <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 text-xs font-bold text-slate-950 bg-gradient-to-r from-indigo-400 to-emerald-400 px-3 py-1 rounded-full uppercase tracking-wider">Most Popular</span>
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-white">Growth Retainer</h3>
          <p class="text-xs text-slate-400">For scaling companies looking to outrank primary industry competitors.</p>
          <div class="text-4xl font-extrabold text-white">$1,999 <span class="text-xs font-normal text-slate-500">/month</span></div>
          <ul class="text-xs text-slate-300 space-y-3 pt-4 border-t border-slate-800">
            <li>✔ Full Technical SEO Management</li>
            <li>✔ 4 High-Intent SEO Articles / Month</li>
            <li>✔ 5 High-Authority White-Hat Backlinks</li>
            <li>✔ Monthly Rank Tracking & Revenue Reporting</li>
          </ul>
        </div>
        <a href="/contact" class="w-full text-center bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl transition text-sm shadow-lg shadow-indigo-600/30">Start Growth Plan</a>
      </div>

      <!-- Enterprise -->
      <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-8 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-white">Enterprise Acceleration</h3>
          <p class="text-xs text-slate-400">Aggressive organic scaling for established brands with multi-region scope.</p>
          <div class="text-4xl font-extrabold text-white">$3,999+ <span class="text-xs font-normal text-slate-500">/month</span></div>
          <ul class="text-xs text-slate-300 space-y-3 pt-4 border-t border-slate-800">
            <li>✔ Everything in Growth</li>
            <li>✔ 10+ High-Intent Articles / Month</li>
            <li>✔ 12+ High-Authority Backlinks</li>
            <li>✔ Dedicated SEO Account Lead</li>
          </ul>
        </div>
        <a href="/contact" class="w-full text-center bg-slate-800 hover:bg-slate-700 text-white font-semibold py-3 rounded-xl transition text-sm">Contact Sales</a>
      </div>
    </div>
  </div>
</MainLayout>
