---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="SEO Services | Technical, On-Page & Link Building"
  description="Explore our specialized SEO service offerings designed to scale organic rankings, improve site architecture, and increase revenue."
>
  <div class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Our SEO Services</h1>
      <p class="text-slate-400 text-lg">
        We provide end-to-end SEO engineering—from fixing critical server bottlenecks to executing high-impact content strategies.
      </p>
    </div>

    <div class="space-y-12">
      <!-- Technical SEO -->
      <div id="technical" class="bg-slate-900/50 border border-slate-800 rounded-2xl p-8 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <span class="text-xs font-semibold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Core Infrastructure</span>
          <h2 class="text-2xl font-bold text-white">Technical SEO & Site Speed Audit</h2>
          <p class="text-slate-400 text-sm leading-relaxed">
            Search engines cannot rank what they cannot efficiently crawl. We perform deep diagnostics on render performance, indexation status, canonical architecture, and structured data schemas.
          </p>
          <ul class="text-sm text-slate-300 space-y-2">
            <li>✔ Core Web Vitals Optimization (LCP, INP, CLS)</li>
            <li>✔ XML Sitemap & Robots.txt restructuring</li>
            <li>✔ Canonicalization & Duplicate Content resolution</li>
            <li>✔ Structured Data Schema (JSON-LD) implementation</li>
          </ul>
        </div>
        <div class="text-center p-6 bg-slate-950 rounded-xl border border-slate-800">
          <div class="text-sm font-medium text-slate-400">Starting At</div>
          <div class="text-3xl font-extrabold text-white my-2">$999</div>
          <a href="/contact" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs px-6 py-3 rounded-lg transition">Request Audit</a>
        </div>
      </div>

      <!-- On Page SEO -->
      <div id="onpage" class="bg-slate-900/50 border border-slate-800 rounded-2xl p-8 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <span class="text-xs font-semibold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Content & Keywords</span>
          <h2 class="text-2xl font-bold text-white">On-Page SEO & Content Strategy</h2>
          <p class="text-slate-400 text-sm leading-relaxed">
            Target keywords with high purchase intent. We optimize title tags, meta headings, entity relationships, and internal linking to maximize page relevancy.
          </p>
          <ul class="text-sm text-slate-300 space-y-2">
            <li>✔ In-depth Keyword Intent & Gap Research</li>
            <li>✔ Title, Meta Description & Heading Optimization</li>
            <li>✔ Semantic Content Clustering & Internal Linking</li>
            <li>✔ Conversion-focused Landing Page Copywriting</li>
          </ul>
        </div>
        <div class="text-center p-6 bg-slate-950 rounded-xl border border-slate-800">
          <div class="text-sm font-medium text-slate-400">Starting At</div>
          <div class="text-3xl font-extrabold text-white my-2">$1,499<span class="text-xs text-slate-400">/mo</span></div>
          <a href="/contact" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs px-6 py-3 rounded-lg transition">Get Started</a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
