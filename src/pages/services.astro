---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="SEO Services | Technical, On-Page & Link Building | askaseo"
  description="Explore our specialized search engineering services designed to scale organic rankings, improve site architecture, and increase revenue."
>
  <div class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20 space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-400 bg-cyan-500/10 px-3.5 py-1.5 rounded-full border border-cyan-500/20">
        Engineered Capabilities
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">
        Precision SEO Services
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        We provide end-to-end SEO engineering—from fixing critical server bottlenecks to executing topical authority and high-DR backlink outreach.
      </p>
    </div>

    <div class="space-y-12">
      <!-- Technical SEO -->
      <div id="technical" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-indigo-500/40 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <span class="text-xs font-bold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Infrastructure Diagnostic</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Technical SEO & Site Speed Audit</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Search engines cannot rank what they cannot efficiently crawl. We perform deep diagnostics on render performance, indexation status, canonical architecture, and structured data schemas.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Core Web Vitals (LCP, INP, CLS)</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> XML Sitemap & Robots Logic</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Canonicalization & Duplicate Bloat</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Structured Data Schema (JSON-LD)</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Fixed Diagnostic</div>
          <div class="text-4xl font-black text-white">$999</div>
          <p class="text-xs text-slate-400">Delivered within 7 business days</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/30 transition-all hover:scale-105">
            Request Technical Audit
          </a>
        </div>
      </div>

      <!-- On Page SEO -->
      <div id="onpage" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-cyan-500/40 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <span class="text-xs font-bold text-cyan-400 bg-cyan-500/10 px-3 py-1 rounded-full border border-cyan-500/20">Topical Relevancy</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Semantic Content & Topical Clusters</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Target keywords with high purchase intent. We optimize title tags, headings, entity relationships, and internal linking to maximize page relevancy and dominate semantic search.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> In-depth Buyer Intent Keyword Mapping</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Semantic Entity & Schema Graphing</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Programmatic Comparison Pages</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Conversion-focused Copywriting</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Monthly Growth Retainer</div>
          <div class="text-4xl font-black text-white">$1,499<span class="text-xs font-normal text-slate-400">/mo</span></div>
          <p class="text-xs text-slate-400">Cancel or pause anytime</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/30 transition-all hover:scale-105">
            Start Content Plan
          </a>
        </div>
      </div>

      <!-- Link Building -->
      <div id="linkbuilding" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-indigo-500/40 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <span class="text-xs font-bold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Domain Authority</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Editorial White-Hat Link Building</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Acquire contextual backlinks from real, vetted industry publications. Zero private blog networks, zero link farms. Strictly manual outreach that builds genuine authority.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Minimum Domain Rating (DR 65+)</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Contextual In-Content Placements</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Competitor Link Intersect Gap Fixes</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> 100% Manual PR Outreach</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Authority Boost</div>
          <div class="text-4xl font-black text-white">$1,999<span class="text-xs font-normal text-slate-400">/mo</span></div>
          <p class="text-xs text-slate-400">Guaranteed real publication links</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/30 transition-all hover:scale-105">
            Boost Domain Authority
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
