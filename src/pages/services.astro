---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="SEO Services | Technical, AI Search & Semantic Architecture | askaseo"
  description="Full-stack SEO services led by Senior SEO Specialist Sanjeeb Chetri. Technical SEO, Google AI Overviews, semantic topical authority, log analysis, and international hreflang."
>
  <div class="py-20 md:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Services Header -->
    <div class="text-center max-w-3xl mx-auto mb-20 space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-400 bg-cyan-500/10 px-3.5 py-1.5 rounded-full border border-cyan-500/20">
        Principal-Led Capabilities
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">
        Engineered Search Services
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Full-stack SEO executed by <strong class="text-white font-semibold">Sanjeeb Chetri</strong>. From deep log-file diagnostics and site migrations to Google AI Overview (AIO) optimization and semantic topic graphs.
      </p>
    </div>

    <!-- 6 Core Specialized Services Grid -->
    <div class="space-y-12">
      
      <!-- Service 1: Technical SEO & Site Migrations -->
      <div id="technical" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-indigo-500/40 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Core Infrastructure</span>
            <span class="text-xs text-slate-400 font-mono">LCP &bull; Indexation &bull; Migrations</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Technical SEO & Zero-Downtime Migrations</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Eliminate critical crawling roadblocks, resolve index bloat, and protect your domain equity during full CMS or domain migrations. We ensure search engines crawl and render your high-value pages with zero friction.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Full website migrations (CMS, domain & structure)</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Core Web Vitals (LCP, INP, CLS) code-level fixes</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Canonicalization & duplicate content elimination</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Dynamic XML Sitemap & Robots.txt architecture</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Fixed Diagnostic</div>
          <div class="text-4xl font-black text-white">$999</div>
          <p class="text-xs text-slate-400">Complete 40+ point audit + Loom walkthrough</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/30 transition-all hover:scale-105">
            Request Technical Audit
          </a>
        </div>
      </div>

      <!-- Service 2: AI Search Optimization (AEO / GEO / AIO) -->
      <div id="ai-search" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-indigo-950/40 via-[#0c101d] to-[#07090e] border border-cyan-500/30 hover:border-cyan-400/60 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center relative overflow-hidden">
        <span class="absolute top-4 right-4 text-[10px] font-black uppercase tracking-wider text-slate-950 bg-gradient-to-r from-cyan-400 to-indigo-300 px-3 py-0.5 rounded-full">
          834K+ AIO Impressions Track Record
        </span>
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-cyan-400 bg-cyan-500/10 px-3 py-1 rounded-full border border-cyan-500/20">Next-Gen Search</span>
            <span class="text-xs text-slate-400 font-mono">Google AIO &bull; Perplexity &bull; ChatGPT</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">AI Search Optimization (AEO / GEO / LLMO)</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Search is no longer just blue links. We engineer your brand's presence in Google AI Overviews and answer engines (Perplexity, ChatGPT, Claude, Gemini) and establish AI-referral conversion attribution directly inside GA4.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Google AI Overviews (AIO) inclusion & citation strategy</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Generative Engine Optimization (GEO) for LLM answer engines</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> GA4 AI assistant referral tracking & conversion setup</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Entity grounding & contextual citation engineering</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Strategic Retainer</div>
          <div class="text-4xl font-black text-white">$1,799<span class="text-xs font-normal text-slate-400">/mo</span></div>
          <p class="text-xs text-slate-400">Full generative search strategy & tracking</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-cyan-600/30 transition-all hover:scale-105">
            Optimize for AI Search
          </a>
        </div>
      </div>

      <!-- Service 3: Semantic SEO & Topical Authority -->
      <div id="semantic" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-indigo-500/40 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Koray Framework Certified</span>
            <span class="text-xs text-slate-400 font-mono">Entity Graphs &bull; Topic Clusters</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Semantic SEO & Topical Authority Architecture</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Certified in Koray Tuğberk Gübür's Semantic SEO Masterclass. We construct multi-layer entity graphs, keyword clusters, and contextual internal linking that establish unmistakable topical authority in your domain.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Semantic keyword clustering & intent mapping</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Content pruning & consolidation (revenue-per-session focus)</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Repeatable high-converting SEO content brief systems</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Information gain & E-E-A-T optimization</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Monthly Growth Retainer</div>
          <div class="text-4xl font-black text-white">$1,499<span class="text-xs font-normal text-slate-400">/mo</span></div>
          <p class="text-xs text-slate-400">Includes topic cluster mapping & briefs</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/30 transition-all hover:scale-105">
            Build Topical Authority
          </a>
        </div>
      </div>

      <!-- Service 4: International & Multilingual SEO -->
      <div id="international" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-cyan-500/40 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-cyan-400 bg-cyan-500/10 px-3 py-1 rounded-full border border-cyan-500/20">Global Scale</span>
            <span class="text-xs text-slate-400 font-mono">hreflang &bull; US/CA &bull; Europe</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">International & Multilingual SEO Architecture</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Proven track record driving +35% YoY MQL growth across US and Canadian markets, alongside multi-region glossary programs in French, German, and Spanish. We structure clean `hreflang` headers and localized templates.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Multilingual `hreflang` architecture & error resolution</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Regional URL structure (subfolders vs subdomains vs ccTLDs)</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Programmatic glossary & template-page scaling</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Geotargeting and localized search intent alignment</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">International Retainer</div>
          <div class="text-4xl font-black text-white">$1,899<span class="text-xs font-normal text-slate-400">/mo</span></div>
          <p class="text-xs text-slate-400">Multi-region & multilingual targeting</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/30 transition-all hover:scale-105">
            Scale Internationally
          </a>
        </div>
      </div>

      <!-- Service 5: Advanced Log-File & N-Gram Search Analytics -->
      <div id="analytics" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-indigo-500/40 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Data Engineering</span>
            <span class="text-xs text-slate-400 font-mono">Server Logs &bull; N-Grams &bull; Fan-Out</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Log-File Analysis & Advanced Search Intelligence</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Stop relying on surface-level crawler simulations. We analyze your actual Apache/Nginx server log files to see exactly when and where Googlebot spends crawl budget, identifying orphan pages and content decay patterns.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Raw server log-file parsing for Googlebot crawl efficiency</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> N-gram and fan-out analysis for intent discovery</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Custom Looker Studio & Search Console API dashboards</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Content decay detection & priority remediation feeds</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Diagnostic & Setup</div>
          <div class="text-4xl font-black text-white">$1,299</div>
          <p class="text-xs text-slate-400">Log parse + custom automated dashboard</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/30 transition-all hover:scale-105">
            Analyze Server Logs
          </a>
        </div>
      </div>

      <!-- Service 6: Structured Data & SEO Automation -->
      <div id="schema-automation" class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-white/[0.04] to-white/[0.01] border border-white/[0.08] hover:border-cyan-500/40 shadow-2xl transition-all duration-300 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-cyan-400 bg-cyan-500/10 px-3 py-1 rounded-full border border-cyan-500/20">Engineering Automation</span>
            <span class="text-xs text-slate-400 font-mono">JSON-LD &bull; Python &bull; n8n</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">JSON-LD Schema & AI Automation Workflows</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Implement multi-entity JSON-LD schema graphs (SoftwareApplication, Organization, Article, FAQ, BreadcrumbList) and build automated SEO monitors using Python, Claude Code MCPs, and n8n to cut research turnaround from days to hours.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Advanced nested JSON-LD schema graphs</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Automated competitor indexing monitors & alerts (n8n/Python)</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> DataForSEO API & Search Console automated pipelines</div>
            <div class="flex items-center gap-2"><span class="text-emerald-400">✔</span> Astro Framework & modern static site SEO configuration</div>
          </div>
        </div>
        <div class="text-center p-8 bg-[#05070c] rounded-2xl border border-white/[0.08] space-y-4">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Custom Engineering</div>
          <div class="text-4xl font-black text-white">$1,499</div>
          <p class="text-xs text-slate-400">Complete schema overhaul & automated monitors</p>
          <a href="/contact" class="w-full inline-block bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-bold text-xs py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/30 transition-all hover:scale-105">
            Automate SEO Workflows
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom CTA Card -->
    <div class="mt-20 rounded-3xl p-8 sm:p-12 bg-gradient-to-r from-indigo-950/70 via-[#0b0e1a] to-[#07090e] border border-indigo-500/30 text-center space-y-6">
      <h3 class="text-2xl sm:text-4xl font-black text-white">
        Unsure Which Search Capability Your Site Needs?
      </h3>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Let Sanjeeb Chetri perform a free 30-point technical diagnostic to pinpoint your exact crawl bottlenecks, indexing bugs, and keyword opportunities.
      </p>
      <div class="pt-2">
        <a 
          href="/#free-audit" 
          class="inline-block px-8 py-4 rounded-xl font-bold text-xs sm:text-sm text-white bg-gradient-to-r from-indigo-600 via-indigo-500 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 shadow-lg shadow-indigo-600/30 transition-all hover:scale-105 border border-white/20"
        >
          Claim Free Technical Audit →
        </a>
      </div>
    </div>

  </div>
</MainLayout>
